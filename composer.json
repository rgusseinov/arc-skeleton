{
    "name": "rgusseinov/arc-skeleton",
    "description": "Application skeleton for the Arc framework",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "rgusseinov/arc-php-framework": "@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "/var/www/html/arc-php-framework",
            "options": { "symlink": true }
        }
    ]
}
